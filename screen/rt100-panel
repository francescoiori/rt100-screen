#!/bin/sh
# Open the RT100 control page as its own window, after the screen service is up.
systemctl --user start rt100screen.service
i=0
while [ "$i" -lt 20 ]; do
  if curl -sf -o /dev/null --max-time 0.4 http://127.0.0.1:8765/; then
    break
  fi
  i=$((i + 1))
  sleep 0.25
done
exec /usr/bin/google-chrome \
  --app=http://127.0.0.1:8765/ \
  --class=RT100Screen \
  --user-data-dir="${HOME}/.local/share/rt100-screen/chrome" \
  --no-first-run \
  --no-default-browser-check \
  --disable-sync \
  --window-size=440,900
