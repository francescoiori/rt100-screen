#!/bin/sh
# Open the RT100 control page as its own window, after the screen service is up.
systemctl --user start rt100screen.service
i=0
while [ "$i" -lt 20 ]; do
  if curl -sf -o /dev/null --max-time 0.4 http://127.0.0.1:8765/; then
    break
  fi
  i=$((i + 1))
  sleep 0.25
done

browser=""
for candidate in google-chrome google-chrome-stable chromium chromium-browser; do
  if command -v "$candidate" >/dev/null 2>&1; then
    browser=$candidate
    break
  fi
done
if [ -z "$browser" ]; then
  exec xdg-open http://127.0.0.1:8765/
fi
exec "$browser" \
  --app=http://127.0.0.1:8765/ \
  --class=RT100Screen \
  --user-data-dir="${HOME}/.local/share/rt100-screen/chrome" \
  --no-first-run \
  --no-default-browser-check \
  --disable-sync \
  --window-size=440,900
